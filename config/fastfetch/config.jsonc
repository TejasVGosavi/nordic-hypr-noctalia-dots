{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/pokemon/*.jpg",
    "width": 42,
    "padding": {
      "top": 7,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "separator": "white"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "red",
        "at": "white",
        "host": "yellow"
      }
    },
    "break",
    {
      "type": "command",
      "name": "󰠃 Pokédex",
      "keyColor": "yellow",
      "text": "bash -c 'q=(\"Mewtwo: The circumstances of your birth are irrelevant.\" \"Blue: Smell ya later!\" \"Pikachu: Pika pika!\" \"Ash: Gotta catch em all!\" \"Team Rocket: Prepare for trouble, and make it double!\" \"Professor Oak: There is a time and place for everything, but not now.\" \"Meowth: We do have a lot in common... the same earth, the same air, the same sky.\"); echo \"${q[RANDOM % ${#q[@]}]}\"'"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1m󰣇 System\u001b[0m"
    },
    { "type": "host", "key": " ├ 󰌢 ", "keyColor": "blue" },
    { "type": "os", "key": " ├ 󰍹 ", "keyColor": "red" },
    { "type": "kernel", "key": " ├  ", "keyColor": "green" },
    { "type": "packages", "key": " ├ 󰏖 ", "keyColor": "yellow" },
    { "type": "shell", "key": " ├  ", "keyColor": "magenta" },
    { "type": "uptime", "key": " └ 󰅐 ", "keyColor": "cyan" },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1m Desktop Environment\u001b[0m"
    },
    { "type": "wm", "key": " ├ 󰨇 ", "keyColor": "magenta" },
    { "type": "wmtheme", "key": " ├ 󰉼 ", "keyColor": "cyan" },
    { "type": "theme", "key": " ├ 󰔎 ", "keyColor": "blue" },
    { "type": "icons", "key": " ├ 󰀻 ", "keyColor": "red" },
    { "type": "cursor", "key": " ├ 󰆿 ", "keyColor": "green" },
    { "type": "font", "key": " ├  ", "keyColor": "yellow" },
    { "type": "terminal", "key": " ├  ", "keyColor": "magenta" },
    { "type": "display", "key": " └ 󰹑 ", "keyColor": "cyan" },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1m󰢮 Hardware & Performance\u001b[0m"
    },
    { "type": "cpu", "key": " ├  ", "keyColor": "blue" },
    { "type": "gpu", "key": " ├ 󰢮 ", "keyColor": "magenta" },
    { "type": "opengl", "key": " ├ 󰢹 ", "keyColor": "cyan" },
    { "type": "memory", "key": " ├  ", "keyColor": "red" },
    { "type": "swap", "key": " ├ 󰓡 ", "keyColor": "green" },
    { "type": "disk", "key": " ├ 󰋊 ", "keyColor": "yellow" },
    { "type": "battery", "key": " ├  ", "keyColor": "magenta" },
    { "type": "poweradapter", "key": " └  ", "keyColor": "cyan" },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1m󰤨 Network & Media\u001b[0m"
    },
    { "type": "localip", "key": " ├ 󰩟 ", "keyColor": "red" },
    { "type": "wifi", "key": " ├  ", "keyColor": "green" },
    { "type": "gamepad", "key": " ├  ", "keyColor": "yellow" },
    { "type": "player", "key": " ├ 󰎆 ", "keyColor": "blue" },
    { "type": "media", "key": " └ 󰝚 ", "keyColor": "magenta" },
    "break",
    {
      "type": "colors",
      "symbol": "diamond"
    }
  ]
}